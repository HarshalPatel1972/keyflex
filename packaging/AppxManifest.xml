<?xml version="1.0" encoding="utf-8"?>
<!--
  Package manifest for the Microsoft Store (MSIX).
  The {{...}} values are filled in by build-msix.ps1.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Keyflex</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Keyflex" Executable="keyflex.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Keyflex"
        Description="Shows you the keyboard shortcut for what you just did the long way."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!--
          Start with Windows. Off until the user switches it on in Keyflex.
          The TaskId must match STARTUP_TASK_ID in src-tauri/src/startup.rs.
        -->
        <desktop:Extension Category="windows.startupTask" Executable="keyflex.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="KeyflexStartup" Enabled="false" DisplayName="Keyflex" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A normal desktop app: needed for the tray icon, input hooks and UI Automation. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
